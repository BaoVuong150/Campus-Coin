# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit file .env.

# Chuỗi kết nối PostgreSQL (Supabase / Neon / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Khóa ký JWT – tối thiểu 32 ký tự ngẫu nhiên.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-chars"

# Khóa bảo vệ endpoint cron /api/cron/recurring (tùy chọn, cần khi bật cron)
CRON_SECRET="replace-with-another-random-secret"

# URL gốc của ứng dụng, dùng để dựng link trong email (BẮT BUỘC ở production cho chức năng quên mật khẩu).
APP_URL="http://localhost:3000"

# Gửi email đặt lại mật khẩu qua Resend (tùy chọn). Chưa cấu hình: môi trường dev in link ra console server.
RESEND_API_KEY=""
MAIL_FROM="Campus Coin <no-reply@example.com>"
