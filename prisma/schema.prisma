generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String    @id @default(uuid())
  name                       String
  email                      String    @unique
  password_hash              String
  role                       String    @default("student") // "student" | "admin"
  is_active                  Boolean   @default(true)
  academic_year              String?
  monthly_allowance_baseline Decimal   @default(0) @db.Decimal(12, 2)
  monthly_savings_goal       Decimal   @default(0) @db.Decimal(12, 2)
  salary_pay_day             Int?      @default(5)
  // Deprecated: dữ liệu đã được chuyển sang bảng recurring_transactions, giữ lại để không mất dữ liệu cũ.
  fixed_bills                Json?
  preferences                Json?
  last_login_at              DateTime?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  transactions           Transaction[]
  budgets                Budget[]
  insights               Insight[]
  saving_tips            SavingTip[]
  categories             Category[]
  notifications          Notification[]
  recurring_transactions RecurringTransaction[]
  saving_goals           SavingGoal[]
  category_preferences   CategoryPreference[]
  point_events           PointEvent[]

  @@index([created_at])
  @@map("users")
}

model Category {
  id         Int      @id @default(autoincrement())
  user_id    String? // null = danh mục mặc định toàn hệ thống, non-null = danh mục cá nhân
  name       String
  type       String // "income" | "expense"
  icon       String?
  color      String?
  is_default Boolean  @default(false)
  created_at DateTime @default(now())

  user                   User?                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  budgets                Budget[]
  recurring_transactions RecurringTransaction[]
  category_preferences   CategoryPreference[]

  @@index([user_id])
  @@map("categories")
}

model Transaction {
  id                    String   @id @default(uuid())
  user_id               String
  category_id           Int
  amount                Decimal  @db.Decimal(12, 2)
  type                  String // "income" | "expense"
  description           String
  ai_suggested_category Int? // danh mục được gợi ý tại thời điểm nhập
  date                  DateTime @default(now())
  is_recurring          Boolean  @default(false)
  recurrence_period     String?
  recurring_id          String?
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now()) @updatedAt

  user      User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category  Category              @relation(fields: [category_id], references: [id], onDelete: Restrict)
  recurring RecurringTransaction? @relation(fields: [recurring_id], references: [id], onDelete: SetNull)

  // Mỗi kỳ của một lịch định kỳ chỉ sinh đúng một giao dịch (idempotency cho scheduler).
  @@unique([recurring_id, date])
  @@index([user_id, date])
  @@index([user_id, category_id])
  @@index([user_id, type, date])
  @@map("transactions")
}

model TransactionAudit {
  id             Int      @id @default(autoincrement())
  transaction_id String
  user_id        String
  action         String // "create" | "update" | "delete"
  snapshot       Json
  created_at     DateTime @default(now())

  @@index([user_id, created_at])
  @@index([transaction_id])
  @@map("transaction_audits")
}

model RecurringTransaction {
  id            String    @id @default(uuid())
  user_id       String
  category_id   Int
  name          String
  amount        Decimal   @db.Decimal(12, 2)
  type          String // "income" | "expense"
  frequency     String // "weekly" | "monthly" | "yearly"
  anchor_day    Int // ngày trong tháng (monthly/yearly) hoặc thứ trong tuần 0-6 (weekly)
  start_date    DateTime
  next_run_date DateTime
  end_date      DateTime?
  status        String    @default("active") // "active" | "paused" | "cancelled"
  is_fixed      Boolean   @default(true) // tính vào chi phí cố định khi dự báo
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [category_id], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([user_id, status])
  @@index([status, next_run_date])
  @@map("recurring_transactions")
}

model SavingGoal {
  id             String    @id @default(uuid())
  user_id        String
  name           String
  target_amount  Decimal   @db.Decimal(12, 2)
  current_amount Decimal   @default(0) @db.Decimal(12, 2)
  deadline       DateTime?
  icon           String?
  status         String    @default("active") // "active" | "completed" | "archived"
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  user          User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([user_id, status])
  @@map("saving_goals")
}

model GoalContribution {
  id         Int      @id @default(autoincrement())
  goal_id    String
  amount     Decimal  @db.Decimal(12, 2) // dương = nạp thêm, âm = rút ra
  note       String?
  created_at DateTime @default(now())

  goal SavingGoal @relation(fields: [goal_id], references: [id], onDelete: Cascade)

  @@index([goal_id, created_at])
  @@map("goal_contributions")
}

// Ghi nhớ lựa chọn danh mục của chính user cho từng từ khóa mô tả (smart categorization).
model CategoryPreference {
  id          Int      @id @default(autoincrement())
  user_id     String
  keyword     String
  category_id Int
  hits        Int      @default(1)
  updated_at  DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, keyword])
  @@map("category_preferences")
}

model Budget {
  id           Int      @id @default(autoincrement())
  user_id      String
  category_id  Int
  month        String // "YYYY-MM"
  limit_amount Decimal  @db.Decimal(12, 2)
  created_at   DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id, month])
  @@index([user_id, month])
  @@map("budgets")
}

model Insight {
  id           Int      @id @default(autoincrement())
  user_id      String
  month        String // "YYYY-MM"
  summary_text String   @db.Text
  tip_text     String   @db.Text
  is_pinned    Boolean  @default(false)
  generated_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Mỗi tháng một ảnh chụp nhận định (cập nhật khi đồng bộ; tháng đã qua giữ nguyên làm lịch sử).
  @@unique([user_id, month])
  @@map("insights")
}

model SavingTip {
  id               Int      @id @default(autoincrement())
  user_id          String? // null = mẹo hệ thống do admin quản lý
  title            String
  content          String   @db.Text
  category_type    String?
  potential_saving Decimal? @db.Decimal(12, 2)
  is_pinned        Boolean  @default(false)
  is_dismissed     Boolean  @default(false)
  /// Khóa mẹo cá nhân (ví dụ "above-average:6:2026-09" hoặc "system:12") – dòng lưu trạng thái ghim/bỏ qua của user.
  tip_key          String?
  created_at       DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, tip_key])
  @@map("saving_tips")
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    String
  title      String
  message    String   @db.Text
  type       String   @default("info") // mức độ: "info" | "warning" | "alert" | "success"
  kind       String   @default("system") // budget_warning | budget_exceeded | recurring | goal | unusual | system
  // Nội dung đa ngôn ngữ: client dựng lại tiêu đề/nội dung từ template + params; title/message là bản tiếng Việt dự phòng.
  template   String?
  params     Json?
  link       String?
  dedupe_key String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Chống spam: cùng một sự kiện chỉ tạo một thông báo cho mỗi user.
  @@unique([user_id, dedupe_key])
  @@index([user_id, is_read, created_at])
  @@map("notifications")
}

// Campus Points: điểm thưởng nội bộ, không phải tiền, không quy đổi.
model PointEvent {
  id         Int      @id @default(autoincrement())
  user_id    String
  reason     String // firstTransaction | dailyLog | goalDeposit | budgetWeek | monthlySavings | goalCompleted
  points     Int
  dedupe_key String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Mỗi sự kiện chỉ được cộng điểm một lần.
  @@unique([user_id, dedupe_key])
  @@index([user_id, created_at])
  @@map("point_events")
}

// Nhật ký thao tác quản trị (khóa/mở tài khoản, đổi quyền, đặt lại mật khẩu, danh mục hệ thống, thông báo, xuất dữ liệu).
// Không đặt khóa ngoại tới users để nhật ký vẫn còn khi tài khoản bị xóa.
model AdminAudit {
  id          Int      @id @default(autoincrement())
  actor_id    String
  action      String
  target_type String
  target_id   String?
  details     Json?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([actor_id, created_at])
  @@map("admin_audits")
}
